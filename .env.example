# Copy to .env.local and adjust. Never commit real values.

# Public base URL used for QR codes and share links. Dev: http://localhost:3101
APP_URL=https://dineloop.craftlayer.store

# Postgres connection. Leave empty to use the PGlite file database in ./.data/pglite.
DATABASE_URL=

# Secret for signing staff session cookies (32+ random characters). A dev fallback is used, with a warning, if unset.
SESSION_SECRET=

# Show the one-time login code on screen (demo). Set to "off" in production once a real SMS adapter exists.
DEMO_OTP=on
